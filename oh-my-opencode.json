{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p5",
      "variant": "medium"
    },
    "prometheus": {
      "model": "zhipuai-coding-plan/glm-5",
      "variant": "xhigh",
      "prompt_append": "Leverage deep & quick agents heavily, always in parallel."
    },
    "atlas": {
      "model": "kimi-for-coding/k2p5",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "explore": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7-highspeed",
      "variant": "medium"
    },
    "librarian": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7-highspeed",
      "variant": "medium"
    },
    "multimodal-looker": {
      "model": "kimi-for-coding/k2p5"
    },
    "metis": {
      "model": "zhipuai-coding-plan/glm-5",
      "variant": "high"
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-5",
      "variant": "high"
    }
  },
  "categories": {
    "quick": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7-highspeed",
      "variant": "medium"
    },
    "unspecified-low": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7-highspeed",
      "variant": "medium"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p5",
      "variant": "high"
    },
    "writing": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7-highspeed",
      "variant": "high"
    },
    "visual-engineering": {
      "model": "kimi-for-coding/k2p5",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "artistry": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    },
    "git": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.7-highspeed",
      "description": "All git operations",
      "prompt_append": "Focus on atomic commits, clear messages, and safe operations."
    }
  },
  "background_task": {
    "providerConcurrency": {
      "openai": 3,
      "minimax-cn-coding-plan": 10,
      "zhipuai-coding-plan": 10,
      "kimi-for-coding": 10
    },
    "modelConcurrency": {
      "openai/gpt-5.2": 3,
      "openai/gpt-5.3-codex": 3,
      "openai/gpt-5.4": 3
    }
  },
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  },
  "tmux": {
    "enabled": false
  },
  "lsp": {
    "biome": {
      "command": [
        "/home/chenjingjue/slidev/zen-moto/node_modules/.bin/biome",
        "lsp-proxy"
      ],
      "extensions": [
        ".css",
        ".json",
        ".js",
        ".jsx",
        ".ts",
        ".tsx"
      ]
    },
    "markdown-language-server": {
      "command": [
        "node",
        "/home/chenjingjue/.local/share/lsp/node/node_modules/markdown-language-server/dist/main.js",
        "--stdio"
      ],
      "extensions": [
        ".md"
      ]
    },
    "fish-lsp": {
      "command": [
        "/home/chenjingjue/.local/share/lsp/node/node_modules/.bin/fish-lsp",
        "start"
      ],
      "extensions": [
        ".fish"
      ]
    },
    "jdtls": {
      "command": [
        "/home/chenjingjue/.local/bin/jdtls-opencode"
      ],
      "extensions": [
        ".java"
      ]
    },
    "rust-analyzer": {
      "command": [
        "/home/chenjingjue/.cargo/bin/rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "lemminx": {
      "command": [
        "/home/chenjingjue/.local/bin/lemminx-opencode"
      ],
      "extensions": [
        ".xml"
      ]
    }
  }
}
