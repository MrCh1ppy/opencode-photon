{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kimi-for-coding": {
      "models": {
      "k3": {
        "attachment": false,
        "headers": {
          "User-Agent": "KimiCLI/1.49.0"
        },
        "id": "k3",
        "interleaved": {
          "field": "reasoning_content"
        },
        "modalities": {
          "input": [
            "text",
            "image",
            "video"
          ],
          "output": [
            "text"
          ]
        },
        "name": "Kimi K3",
        "options": {
          "thinking": {
            "budgetTokens": 31999,
            "type": "enabled"
          }
        },
        "reasoning": true
      },

      "kimi-for-coding": {
        "attachment": false,
        "headers": {
          "User-Agent": "KimiCLI/1.49.0"
        },
        "id": "kimi-for-coding",
        "interleaved": {
          "field": "reasoning_content"
        },
        "modalities": {
          "input": [
            "text",
            "image",
            "video"
          ],
          "output": [
            "text"
          ]
        },
        "name": "Kimi K2.7 Code",
        "options": {
          "thinking": {
            "budgetTokens": 16000,
            "type": "enabled"
          }
        },
        "reasoning": true
      },

      "kimi-for-coding-highspeed": {
        "attachment": false,
        "headers": {
          "User-Agent": "KimiCLI/1.49.0"
        },
        "id": "kimi-for-coding-highspeed",
        "interleaved": {
          "field": "reasoning_content"
        },
        "modalities": {
          "input": [
            "text",
            "image",
            "video"
          ],
          "output": [
            "text"
          ]
        },
        "name": "Kimi K2.7 Code Highspeed",
        "options": {
          "thinking": {
            "budgetTokens": 16000,
            "type": "enabled"
          }
        },
        "reasoning": true
      }
    },

    "name": "Kimi For Coding",
    "npm": "@ai-sdk/anthropic",
    "options": {
      "apiKey": "{env:KIMI_FOR_CODING_API_KEY}",
      "baseURL": "https://api.kimi.com/coding/v1"
    }
  },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}",
        "baseURL": "https://api.aicodemirror.com/api/codex/backend-api/codex"
      },
      "models": {
        "gpt-5.6-terra": {
          "id": "gpt-5.6-terra",
          "name": "GPT-5.6 Terra"
        },
        "gpt-5.6-sol": {
          "id": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol"
        }
      }
    }
  }
}
